# ============================================================
# Credit-Risk-ML-System — .gitignore
# ============================================================
# NOTE: the runtime artifacts below are *intentionally committed* and must
# NOT be ignored, because the deployed API loads them at startup:
#   credit_risk_model.pkl   best_threshold.pkl   credit_risk_dataset.csv
# (It is why there is no blanket "*.pkl" / "*.csv" rule here.)

# ---------- Python ----------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/

# ---------- Virtual environments ----------
.venv/
venv/
env/
ENV/

# ---------- Jupyter ----------
.ipynb_checkpoints/
*/.ipynb_checkpoints/*
profile_default/

# ---------- Testing / linting / type-checking caches ----------
.pytest_cache/
.mypy_cache/
.ruff_cache/
.cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/

# ---------- Secrets / local config ----------
.env
.env.*
!.env.example
*.local

# ---------- Editors & OS ----------
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo
*~
